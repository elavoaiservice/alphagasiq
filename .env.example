# Copy to .env and fill in what you have. Every value below has a working fallback
# (mock provider / SIMULATED data / dev-mode auth) so `docker compose up` runs the full
# platform with zero of these set.

ENVIRONMENT=development

# --- Database / cache / streaming ------------------------------------------------
DATABASE_URL=postgresql+asyncpg://alphagasiq:alphagasiq@postgres:5432/alphagasiq
REDIS_URL=redis://redis:6379/0
EVENT_BUS_IMPL=memory
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- Auth --------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-32-byte-value-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Dev-mode login passwords (apps/api/api_app/auth.py). Optional — each falls back to
# its built-in default (e.g. "admin-dev-password") if unset. Set strong values in any
# reachable deployment. SUPER_ADMIN is a dev-only convenience account that unlocks the
# super-admin admin pages without SMTP/OIDC; the production path is a real DB
# SUPER_ADMIN UserRow via magic-link or OIDC.
DEV_ADMIN_PASSWORD=
DEV_TRADER_PASSWORD=
DEV_RISK_PASSWORD=
DEV_SUPERADMIN_PASSWORD=

# --- GUI-managed configuration (super-admin Configuration page) --------------------
# Fernet key used to encrypt secret values entered in the admin Configuration page
# (stored in the app_config table) at rest. Optional: if unset, those values are
# stored in plaintext (acceptable only for a private/local prototype). Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# --- Real OIDC / SSO (Authorization Code + PKCE) ------------------------------------
# Leave all four unset to keep using the dev-mode password-grant login (the default —
# GET /auth/mode will report oidc_configured: false). Set all four to enable real SSO
# alongside (never instead of) the dev login; see docs/architecture.md §8 "Auth: real
# OIDC" and apps/api/api_app/oidc.py.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_AUDIENCE=
# Claim in the ID token carrying this platform's roles (ADMIN/TRADER/RISK_MANAGER/
# RESEARCHER/VIEWER) — adjust to match your IdP's claim name/namespace.
OIDC_ROLES_CLAIM=roles
# Roles granted when none of the claim's values match a recognized Role — keep this
# read-only unless you intend every unmapped SSO user to get elevated access.
OIDC_DEFAULT_ROLES=VIEWER

# --- Neo4j-backed pipeline digital twin (optional; additive) ------------------------
# Leave NEO4J_URI unset to keep the plain in-memory pipeline graph (the default).
# Set it to seed/reload that same graph through a real Neo4j instance instead — start
# one with `docker compose --profile neo4j up` (matches the credentials below), or
# point at any Neo4j 5.x instance. See docs/architecture.md §8 "Neo4j-backed pipeline
# graph" and fundamentals_service/pipeline_graph_neo4j.py.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=alphagasiq-dev
NEO4J_DATABASE=

# --- AI --------------------------------------------------------------------------
# Without this, the platform runs on MockLLMProvider — deterministic, offline, and
# clearly labeled — so every agent still produces auditable output.
ANTHROPIC_API_KEY=

# --- PUBLIC data providers -----------------------------------------------------
EIA_API_KEY=
NOAA_API_TOKEN=
# ISO/RTO fuel-type data (services/data/data_service/providers/iso_rto.py) shares
# EIA_API_KEY above -- same api.eia.gov v2 credential, no separate key needed.
# SEC EDGAR (providers/sec_edgar.py) needs no API key at all, only a descriptive
# contact per SEC's fair-access policy -- set this to your own contact email.
SEC_EDGAR_CONTACT_EMAIL=

# --- LICENSED data providers (never assumed free; falls back to Mock*Provider) --
CME_API_ID=
CME_API_SECRET=
NEWS_PROVIDER_API_KEY=

# --- Object storage (S3-compatible; MinIO in dev) --------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=alphagasiq-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Feature flags -----------------------------------------------------------------
USE_MOCK_MARKET_DATA=true
USE_MOCK_NEWS=true

# --- CORS ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Frontend ------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
