# AlphaGasIQ API / worker image. Build context is the repo root (see docker-compose.yml)
# because the API depends on every local package/service in the monorepo.
FROM python:3.11-slim AS base

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# System deps for httpx/psycopg-style builds; kept minimal.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Copy every local package/service so `pip install -e` resolves them from disk
# rather than PyPI (they are private to this monorepo, not published).
COPY packages/ ./packages/
COPY services/ ./services/
COPY apps/api/ ./apps/api/

RUN pip install --upgrade pip && pip install \
    -e packages/schemas \
    -e packages/data-sdk \
    -e packages/agent-sdk \
    -e packages/config \
    -e services/data \
    -e services/fundamentals \
    -e services/risk \
    -e services/paper-execution \
    -e services/agents \
    -e apps/api

EXPOSE 8000
CMD ["uvicorn", "api_app.main:app", "--host", "0.0.0.0", "--port", "8000"]
