# AlphaGasIQ API / worker image. Build context is the repo root (see docker-compose.yml)
# because the API depends on every local package/service in the monorepo.

# Stage 1: stamp the image with the git commit it is being built from, so the admin
# Upgrade page can report what is *actually running* rather than what the host has
# checked out (a `git pull` with no rebuild is exactly the case that must be visible).
# `git` lives only in this throwaway stage -- the runtime image never gets it.
# Requires `.git` in the build context, which a git clone always has; if it is
# missing the stamp is simply absent and the panel reports "unknown".
FROM python:3.11-slim AS gitstamp
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /stamp
COPY .git /stamp/.git
COPY infrastructure/docker/build_stamp.py /stamp/build_stamp.py
RUN python3 /stamp/build_stamp.py /stamp/.git /stamp

FROM python:3.11-slim AS base

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# System deps for httpx/psycopg-style builds; kept minimal.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Copy every local package/service so `pip install -e` resolves them from disk
# rather than PyPI (they are private to this monorepo, not published).
COPY packages/ ./packages/
COPY services/ ./services/
COPY apps/api/ ./apps/api/

RUN pip install --upgrade pip && pip install \
    -e packages/schemas \
    -e packages/data-sdk \
    -e packages/agent-sdk \
    -e packages/config \
    -e packages/db \
    -e services/data \
    -e services/fundamentals \
    -e services/risk \
    -e services/paper-execution \
    -e services/agents \
    -e services/quant \
    -e services/alpha \
    -e services/enterprise_data \
    -e apps/api

# Read at runtime by `api_app/version.py` ("Running" version) and
# `api_app/changelog.py` (the admin Changelog feed). Copied last so a new commit
# does not invalidate the (expensive) pip-install layer above.
COPY --from=gitstamp /stamp/build-info.json /app/build-info.json
COPY --from=gitstamp /stamp/changelog.json /app/changelog.json

EXPOSE 8000
CMD ["uvicorn", "api_app.main:app", "--host", "0.0.0.0", "--port", "8000"]
